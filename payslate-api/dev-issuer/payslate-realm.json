{
  "realm": "payslate",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "PAYROLL_OFFICER"
      },
      {
        "name": "EMPLOYEE"
      }
    ]
  },
  "clients": [
    {
      "clientId": "payslate-ui",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "employer-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "employer_id",
            "claim.name": "employer_id",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "employee-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "employee_id",
            "claim.name": "employee_id",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "officer-a",
      "enabled": true,
      "attributes": {
        "employer_id": [
          "synthetic-a"
        ]
      },
      "realmRoles": [
        "PAYROLL_OFFICER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-a",
          "temporary": false
        }
      ],
      "firstName": "Officer",
      "lastName": "Test",
      "email": "officer-a@payslate.example",
      "emailVerified": true,
      "requiredActions": []
    },
    {
      "username": "officer-b",
      "enabled": true,
      "attributes": {
        "employer_id": [
          "synthetic-b"
        ]
      },
      "realmRoles": [
        "PAYROLL_OFFICER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-b",
          "temporary": false
        }
      ],
      "firstName": "Officer",
      "lastName": "Test",
      "email": "officer-b@payslate.example",
      "emailVerified": true,
      "requiredActions": []
    },
    {
      "username": "employee-a",
      "enabled": true,
      "attributes": {
        "employer_id": [
          "synthetic-a"
        ],
        "employee_id": [
          "1"
        ]
      },
      "realmRoles": [
        "EMPLOYEE"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-employee",
          "temporary": false
        }
      ],
      "firstName": "Employee",
      "lastName": "Test",
      "email": "employee-a@payslate.example",
      "emailVerified": true,
      "requiredActions": []
    }
  ]
}
