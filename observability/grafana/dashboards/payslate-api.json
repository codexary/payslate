{
  "uid": "payslate-api",
  "title": "Payslate API",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "payslate"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Which routes are receiving traffic? Health probes are excluded. Requests matching no route appear as /** (404) or UNKNOWN (rejected before routing).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{service_name=\"payslate-api\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "4xx responses by route and status",
      "description": "Which routes are rejecting requests, and with which status? Requests matching no route appear as /** (404) or UNKNOWN (rejected before routing).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{service_name=\"payslate-api\",uri!~\"/actuator.*\",status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "{{uri}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx responses by route",
      "description": "Which routes are failing on the server? Zero means no server errors were observed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{service_name=\"payslate-api\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval])) or on() label_replace(vector(0), \"uri\", \"no 5xx\", \"\", \"\")",
          "legendFormat": "{{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency by route",
      "description": "How slow are requests? p95 uses the rate window; max shows the peak exported maximum within each query interval. Both are in seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service_name=\"payslate-api\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p95 {{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by (uri) (max_over_time(http_server_requests_max_seconds{service_name=\"payslate-api\",uri!~\"/actuator.*\"}[$__interval]))",
          "legendFormat": "max {{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request threads in use",
      "description": "Busy Tomcat request threads as a percentage of the configured maximum of 200 threads, showing the peak per 10-second interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (name) (max_over_time(tomcat_threads_busy{service_name=\"payslate-api\"}[$__interval])) / sum by (name) (tomcat_threads_config_max{service_name=\"payslate-api\"})",
          "legendFormat": "Busy Tomcat threads: {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Database connections in use",
      "description": "Active Hikari database connections as a percentage of the configured maximum of 10 connections, showing the peak per 10-second interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "B",
          "expr": "100 * sum by (pool) (max_over_time(hikaricp_connections_active{service_name=\"payslate-api\"}[$__interval])) / sum by (pool) (hikaricp_connections_max{service_name=\"payslate-api\"})",
          "legendFormat": "Active Hikari connections: {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    }
  ]
}
